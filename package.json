{
  "type": "module",
  "version": "0.1.2",
  "license": "MIT",
  "name": "@niftyers/next-ui",
  "description": "A simple, open source, accessible next ui components on top of talwindcss.",
  "author": "Lambert Cadalzo <dev@niftyers.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/niftyers/niftyers-next-ui.git"
  },
  "keywords": [
    "nextjs",
    "tailwindcss",
    "typescript",
    "ui",
    "components"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup core/index.ts --watch --dts",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write './core/**/*.{ts,tsx,js,json,css,md}'",
    "prepublishOnly": "npm run build",
    "build": "tsup core/index.ts --format esm,cjs --dts --tsconfig tsconfig.build.json --out-dir dist"
  },
  "peerDependencies": {
    "next": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.1",
    "@types/node": "^20.19.9",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.0.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tailwindcss": "^3.0.0",
    "lucide-react": "^0.479.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss-animate": "^1.0.0",
    "tsup": "^7.2.0",
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  }
}
